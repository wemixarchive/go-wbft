{
  "test_scenarios": [
    {
      "scenario_name": "Tampered Header in Proposal Test",
      "description": "Proposer가 블록 헤더의 일부 필드를 누락시킨 Proposal을 PrePrepare 메시지로 브로드캐스트",
      "enabled": true,
      "attacks": [
        {
          "name": "omit_all_prev_prepare_seals",
          "type": "omitMessage",
          "enabled": true,
          "seq_s": 100,
          "seq_e": 100,
          "round": 0,
          "code": 1,
          "parameters": {
            "code": 1,
            "cmd": 1,
            "cnt": 0,
            "targets": []
          }
        }
      ],
      "expected_behavior": {
        "consensus": "round_change",
        "reason": "밸리데이터들이 누락된 seal을 탐지하고 Prepare 메시지를 전송하지 않음",
        "logs": [
          "WBFT: invalid PRE-PREPARE block proposal",
          "Prepare 메시지 미전송 확인"
        ]
      }
    },
    {
      "scenario_name": "Partial Seal Omission Test",
      "description": "일부 seal만 누락시켜 전송하는 테스트",
      "enabled": true,
      "attacks": [
        {
          "name": "omit_partial_commit_seals",
          "type": "omitMessage",
          "enabled": true,
          "seq_s": 200,
          "seq_e": 205,
          "round": 0,
          "parameters": {
            "code": 1,
            "cmd": 2,
            "cnt": 3,
            "targets": []
          }
        }
      ],
      "expected_behavior": {
        "consensus": "validation_failure",
        "reason": "불충분한 seal로 인한 검증 실패",
        "logs": [
          "insufficient seals",
          "validation failed"
        ]
      }
    },
    {
      "scenario_name": "Propagation Seal Omission Test",
      "description": "블록 전파 시 seal을 누락시키는 테스트",
      "enabled": true,
      "attacks": [
        {
          "name": "omit_all_commit_seals_on_propagation",
          "type": "omitMessage",
          "enabled": true,
          "seq_s": 300,
          "seq_e": 300,
          "round": 0,
          "parameters": {
            "code": 32,
            "cmd": 2,
            "cnt": 0,
            "targets": []
          }
        }
      ],
      "expected_behavior": {
        "consensus": "block_rejected",
        "reason": "commit seal이 없는 블록은 거부됨",
        "logs": [
          "missing commit seals",
          "block rejected"
        ]
      }
    },
    {
      "scenario_name": "RoundChange Justification Omission Test",
      "description": "RoundChange 후 PrePrepare에서 justification을 누락시키는 테스트",
      "enabled": true,
      "attacks": [
        {
          "name": "omit_roundchange_messages",
          "type": "omitMessage",
          "enabled": true,
          "seq_s": 400,
          "seq_e": 400,
          "round": 1,
          "parameters": {
            "code": 16,
            "cmd": 1,
            "cnt": 0,
            "targets": []
          }
        }
      ],
      "expected_behavior": {
        "consensus": "invalid_justification",
        "reason": "RoundChange justification이 없으면 PrePrepare 거부",
        "logs": [
          "invalid PRE-PREPARE message justification",
          "missing round change justification"
        ]
      }
    },
    {
      "scenario_name": "Targeted Omission Test",
      "description": "특정 밸리데이터에게만 누락된 메시지를 전송하는 테스트",
      "enabled": true,
      "attacks": [
        {
          "name": "targeted_seal_omission",
          "type": "omitMessage",
          "seq_s": 500,
          "seq_e": 510,
          "round": 0,
          "enabled": true,
          "parameters": {
            "code": 1,
            "cmd": 1,
            "cnt": 2,
            "targets": [
              "0x1111111111111111111111111111111111111111",
              "0x2222222222222222222222222222222222222222"
            ]
          }
        }
      ],
      "expected_behavior": {
        "consensus": "partial_failure",
        "reason": "일부 노드만 메시지를 거부하고 나머지는 정상 처리",
        "logs": [
          "targeted nodes reject message",
          "consensus may continue with remaining nodes"
        ]
      }
    },
    {
      "scenario_name": "Maximum Omission Stress Test",
      "description": "최대한 많은 seal을 누락시켜 시스템 반응 테스트",
      "enabled": true,
      "attacks": [
        {
          "name": "max_omission_preprepare",
          "type": "omitMessage",
          "enabled": true,
          "seq_s": 600,
          "seq_e": 610,
          "round": 0,
          "parameters": {
            "code": 1,
            "cmd": 1,
            "cnt": 0,
            "targets": []
          }
        },
        {
          "name": "max_omission_propagation",
          "type": "omitMessage",
          "enabled": true,
          "seq_s": 600,
          "seq_e": 610,
          "round": 0,
          "parameters": {
            "code": 32,
            "cmd": 2,
            "cnt": 0,
            "targets": []
          }
        }
      ],
      "expected_behavior": {
        "consensus": "complete_failure",
        "reason": "모든 seal이 누락되면 합의 불가능",
        "logs": [
          "no valid seals found",
          "consensus failure"
        ]
      }
    }
  ],
  "configuration_notes": {
    "code_values": {
      "1": "PrePrepare",
      "2": "Prepare",
      "4": "Commit",
      "8": "RoundChange",
      "16": "Propagation"
    },
    "cmd_values": {
      "PrePrepare": {
        "1": "omit prev Prepare Seal",
        "2": "omit prev Commit Seal"
      },
      "Propagation": {
        "1": "omit Prepare Seal",
        "2": "omit Commit Seal"
      },
      "RoundChange-PrePrepare": {
        "1": "omit RoundChangeMessages",
        "2": "omit PrepareMessages"
      }
    },
    "cnt_values": {
      "0": "omit all",
      "n": "omit first n items"
    }
  }
}